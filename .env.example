# ---------------------------------------------------------------------------
# The Editing Plug — environment configuration
#
# Copy this file to `.env` and fill in the values you want to use.
#   cp .env.example .env
#
# `.env` is git-ignored. Only put PUBLIC values here: every VITE_* variable is
# bundled into the client-side JavaScript and is visible to anyone who views
# the site. Never put a private API key, SMTP password or secret token in here.
# ---------------------------------------------------------------------------

# --- Enquiry form -----------------------------------------------------------
# Where the enquiry form POSTs its JSON payload.
# Until this is set, the form validates normally but will NOT claim to have
# sent anything — it tells the visitor to email instead.
#
# Formspree:  https://formspree.io  -> VITE_ENQUIRY_ENDPOINT=https://formspree.io/f/xxxxxxxx
# Web3Forms:  https://web3forms.com -> VITE_ENQUIRY_ENDPOINT=https://api.web3forms.com/submit
#                                      (also set VITE_ENQUIRY_ACCESS_KEY below)
# Your own backend: any URL that accepts a JSON POST and returns 2xx on success.
VITE_ENQUIRY_ENDPOINT=

# Only required by providers that need a public access key in the body
# (Web3Forms calls this `access_key`). Leave blank for Formspree.
VITE_ENQUIRY_ACCESS_KEY=

# --- Book a call ------------------------------------------------------------
# Your Calendly scheduling link, e.g. https://calendly.com/your-name/30min
# When set, the "Book a Call" buttons open the Calendly popup.
# When blank, they scroll to the enquiry form instead — no fake availability
# is ever shown.
VITE_CALENDLY_URL=
